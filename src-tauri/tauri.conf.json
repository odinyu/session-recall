{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Recall",
  "version": "1.2.1",
  "identifier": "com.odinyu.session-recall",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sessionrecall"],
        "name": "Session Recall session link",
        "role": "Viewer"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/dist": "web/dist"
    },
    "externalBin": ["binaries/session-recall"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
